    }
  ]);

  const handleChangeJobTitle = (e) => {
    setJobTitle(e.target.value);
  }

  const handleChangeJobLocation = (e) => {
    setJobLocation(e.target.value);
  }

  const handleChangeJobDescription = (e) => {
    setJobDescription(e.target.value);
  }

